 {
 	struct vb2_v4l2_buffer *src_buf;
@@ -162,17 +301,91 @@ void hantro_end_prepare_run(struct hantro_ctx *ctx)
 	v4l2_ctrl_request_complete(src_buf->vb2_buf.req_obj.req,
 				   &ctx->ctrl_handler);
 
-	/* Kick the watchdog. */
-	schedule_delayed_work(&ctx->dev->watchdog_work,
-			      msecs_to_jiffies(2000));
+	hantro_watchdog_kick(ctx);
+}
+
+/* Fallible acquisitions and validation happen before hardware enable. */
+static void device_run_h264(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct vb2_v4l2_buffer *src = hantro_get_src_buf(ctx);
+	struct vb2_v4l2_buffer *dst = hantro_get_dst_buf(ctx);
+	struct hantro_h264_job *job;
+	bool pm_acquired = false;
+	bool clocks_enabled = false;
+	unsigned long flags;
+	int ret;
+
+	job = kzalloc(sizeof(*job), GFP_KERNEL);
+	if (!job)
+		goto err_cancel_job;
+	job->ctx = ctx;
+	job->src = src;
+	job->dst = dst;
+	job->owner = HANTRO_H264_PREPARING;
+	INIT_DELAYED_WORK(&job->watchdog, hantro_h264_timeout);
+	INIT_WORK(&job->completion_work, hantro_h264_complete);
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	ctx->h264_job = job;
+	vpu->h264_job = job;
+	ret = ctx->h264_abort ? -ECANCELED : 0;
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+	if (ret)
+		goto err_cancel_job;
+
+	ret = pm_runtime_resume_and_get(vpu->dev);
+	if (ret < 0)
+		goto err_cancel_job;
+	pm_acquired = true;
+	ret = clk_bulk_enable(vpu->variant->num_clocks, vpu->clocks);
+	if (ret)
+		goto err_cancel_job;
+	clocks_enabled = true;
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	vpu->h264_mmio_live = true;
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+
+	v4l2_m2m_buf_copy_metadata(src, dst);
+	ret = ctx->codec_ops->run(ctx);
+	if (!ret)
+		return; /* Completion may already have freed job and ctx. */
+
+err_cancel_job:
+	/* PREPARING cannot be claimed. No work/timer was queued on rejection. */
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	if (vpu->h264_mmio_live && ctx->codec_ops->reset)
+		ctx->codec_ops->reset(ctx);
+	vpu->h264_mmio_live = false;
+	vpu->h264_job = NULL;
+	ctx->h264_job = NULL;
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+	v4l2_ctrl_request_complete(src->vb2_buf.req_obj.req, &ctx->ctrl_handler);
+	if (clocks_enabled)
+		clk_bulk_disable(vpu->variant->num_clocks, vpu->clocks);
+	if (pm_acquired)
+		pm_runtime_put_autosuspend(vpu->dev);
+	kfree(job);
+	hantro_job_finish_no_pm(vpu, ctx, VB2_BUF_STATE_ERROR);
 }
 
 static void device_run(void *priv)
 {
 	struct hantro_ctx *ctx = priv;
 	struct vb2_v4l2_buffer *src, *dst;
+	unsigned long flags;
 	int ret;
 
+	if (ctx->is_encoder) {
+		spin_lock_irqsave(&ctx->dev->irqlock, flags);
+		ctx->dev->h264_irq_mode =
+			ctx->vpu_dst_fmt->codec_mode == HANTRO_MODE_H264_ENC;
+		spin_unlock_irqrestore(&ctx->dev->irqlock, flags);
+	}
+	if (ctx->is_encoder && ctx->vpu_dst_fmt->codec_mode == HANTRO_MODE_H264_ENC) {
+		device_run_h264(ctx);
+		return;
+	}
+
 	src = hantro_get_src_buf(ctx);
 	dst = hantro_get_dst_buf(ctx);
 
