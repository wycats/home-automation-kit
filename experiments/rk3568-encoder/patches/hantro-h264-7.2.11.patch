 static void
 assemble_scaling_list(struct hantro_ctx *ctx)
 {
@@ -519,3 +1158,145 @@ int hantro_h264_dec_init(struct hantro_ctx *ctx)
 
 	return 0;
 }
+
+unsigned int hantro_h264_enc_rec_luma_size(unsigned int width,
+					   unsigned int height)
+{
+	return round_up(width, MB_DIM) * round_up(height, MB_DIM);
+}
+
+unsigned int hantro_h264_enc_rec_image_size(unsigned int width,
+					    unsigned int height)
+{
+	/* Reconstructed image is YUV 4:2:0 with 1.5 bpp. */
+	return hantro_h264_enc_rec_luma_size(width, height) * 3 / 2;
+}
+
+int hantro_h264_enc_prepare_run(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_enc_hw_ctx *h264_ctx = &ctx->h264_enc;
+	struct hantro_h264_enc_ctrls *ctrls = &h264_ctx->ctrls;
+	struct vb2_v4l2_buffer *src = hantro_get_src_buf(ctx);
+	int ret;
+
+	if (!src)
+		return -EINVAL;
+	ret = v4l2_ctrl_request_setup(src->vb2_buf.req_obj.req, &ctx->ctrl_handler);
+	if (ret)
+		return ret;
+
+	ctrls->encode =
+		hantro_get_ctrl(ctx, V4L2_CID_STATELESS_H264_ENCODE_PARAMS);
+	if (WARN_ON(!ctrls->encode))
+		return -EINVAL;
+
+	ctrls->rc =
+		hantro_get_ctrl(ctx, V4L2_CID_STATELESS_H264_ENCODE_RC);
+	if (WARN_ON(!ctrls->rc))
+		return -EINVAL;
+
+	return hantro_h264_enc_validate(ctrls->encode, ctrls->rc,
+				      ctx->src_fmt.width, ctx->src_fmt.height);
+}
+
+void hantro_h264_enc_exit(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_h264_enc_hw_ctx *h264_enc = &ctx->h264_enc;
+	struct hantro_aux_buf *cabac_table = h264_enc->cabac_table;
+	unsigned int i;
+
+	for (i = 0; i < HANTRO_H264_ENC_CABAC_TABLE_COUNT; i++) {
+		if (!cabac_table[i].cpu || !cabac_table[i].size)
+			continue;
+
+		dma_free_coherent(vpu->dev, cabac_table[i].size,
+				  cabac_table[i].cpu, cabac_table[i].dma);
+
+		cabac_table[i].cpu = NULL;
+		cabac_table[i].size = 0;
+	}
+}
+
+#define CLIP3(v, min, max)  ((v) < (min) ? (min) : ((v) > (max) ? (max) : (v)))
+
+static void cabac_table_init(struct hantro_aux_buf *cabac_table,
+			     u32 cabac_init_idc)
+{
+	u8 *table = cabac_table->cpu;
+	u64 *buffer = cabac_table->cpu;
+	unsigned int i, j;
+	unsigned int size;
+	s32 qp;
+
+	/* Iterate possible QP values. */
+	for (qp = 0; qp < 52; qp++) {
+		/* Iterate intra/inter modes. */
+		for (j = 0; j < 2; j++) {
+			const s32 (*context)[460][2];
+
+			if (j == 0)
+				context = &h264_context_init_intra;
+			else
+				context = &h264_context_init[cabac_init_idc];
+
+			for (i = 0; i < 460; i++) {
+				s32 m = (s32)(*context)[i][0];
+				s32 n = (s32)(*context)[i][1];
+
+				s32 pre_ctx_st = CLIP3(((m * qp) >> 4) + n,
+						       1, 126);
+				u32 idx = qp * 464 * 2 + j * 464 + i;
+
+				if (pre_ctx_st <= 63)
+					table[idx] = (u8)((63 - pre_ctx_st) << 1);
+				else
+					table[idx] = (u8)(((pre_ctx_st - 64) << 1) | 1);
+			}
+		}
+	}
+
+	size = HANTRO_H264_ENC_CABAC_TABLE_SIZE / sizeof(*buffer);
+
+	for (i = 0; i < size; i++)
+		buffer[i] = cpu_to_be64(buffer[i]);
+}
+
+int hantro_h264_enc_init(struct hantro_ctx *ctx)
+{
+	struct hantro_dev *vpu = ctx->dev;
+	struct hantro_h264_enc_hw_ctx *h264_enc = &ctx->h264_enc;
+	struct hantro_aux_buf *cabac_table = h264_enc->cabac_table;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < HANTRO_H264_ENC_CABAC_TABLE_COUNT; i++) {
+		cabac_table[i].size = HANTRO_H264_ENC_CABAC_TABLE_SIZE;
+		cabac_table[i].cpu = dma_alloc_coherent(vpu->dev,
+							cabac_table[i].size,
+							&cabac_table[i].dma,
+							GFP_KERNEL);
+		if (!cabac_table[i].cpu) {
+			ret = -ENOMEM;
+			goto error;
+		}
+
+		cabac_table_init(&cabac_table[i], i);
+	}
+
+	return 0;
+
+error:
+	for (i = 0; i < HANTRO_H264_ENC_CABAC_TABLE_COUNT; i++) {
+		if (!cabac_table[i].cpu || !cabac_table[i].size)
+			continue;
+
+		dma_free_coherent(vpu->dev, cabac_table[i].size,
+				  cabac_table[i].cpu, cabac_table[i].dma);
+
+		cabac_table[i].cpu = NULL;
+		cabac_table[i].size = 0;
+	}
+
+	return ret;
+}
diff --git a/drivers/media/platform/verisilicon/hantro_h264_enc_validate.h b/drivers/media/platform/verisilicon/hantro_h264_enc_validate.h
new file mode 100644
index 0000000..4ae5a01
--- /dev/null
+++ b/drivers/media/platform/verisilicon/hantro_h264_enc_validate.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef HANTRO_H264_ENC_VALIDATE_H
+#define HANTRO_H264_ENC_VALIDATE_H
+#include <linux/errno.h>
+#include <linux/v4l2-controls.h>
+
+/* Initial laboratory envelope. This is not complete request/DMA validation. */
+static inline int hantro_h264_enc_validate(
+	const struct v4l2_ctrl_h264_encode_params *p,
+	const struct v4l2_ctrl_h264_encode_rc *r,
+	unsigned int width, unsigned int height)
+{
+	if (!p || !r || width < 16 || width > 1920 ||
+	    height < 16 || height > 1088 || width % 16 || height % 16)
+		return -EINVAL;
+	/* These values index 52-element tables and select a CABAC table. */
+	if (r->qp > 51 || r->qp_min > r->qp || r->qp_max < r->qp ||
+	    r->qp_max > 51 || p->cabac_init_idc > 2)
+		return -EINVAL;
+	if (p->slice_type != V4L2_H264_SLICE_TYPE_I &&
+	    p->slice_type != V4L2_H264_SLICE_TYPE_P)
+		return -EINVAL;
+	if (p->slice_size_mb_rows < 0 ||
+	    (unsigned int)p->slice_size_mb_rows > height / 16 ||
+	    p->disable_deblocking_filter_idc > 2 ||
+	    p->pic_init_qp_minus26 < -26 || p->pic_init_qp_minus26 > 25 ||
+	    p->slice_alpha_c0_offset_div2 < -6 || p->slice_alpha_c0_offset_div2 > 6 ||
+	    p->slice_beta_offset_div2 < -6 || p->slice_beta_offset_div2 > 6 ||
+	    p->chroma_qp_index_offset < -12 || p->chroma_qp_index_offset > 12 ||
+	    p->flags & ~(V4L2_H264_ENCODE_FLAG_ENTROPY_CODING_MODE |
+			 V4L2_H264_ENCODE_FLAG_TRANSFORM_8X8_MODE |
+			 V4L2_H264_ENCODE_FLAG_CONSTRAINED_INTRA_PRED))
+		return -EINVAL;
+	return 0;
+}
+/* The prototype reads this register as a bit count. Until hardware validation,
+ * reject partial bytes rather than silently rounding or exposing excess data.
+ * This bounds the reported payload; it cannot prove DMA respected its limit.
+ */
+static inline int hantro_h264_enc_payload_size(unsigned int bits,
+					     unsigned long capacity,
+					     unsigned int *bytes_used)
+{
+	if (!bytes_used)
+		return -EINVAL;
+	*bytes_used = 0;
+	if (bits % 8)
+		return -EINVAL;
+	if (bits / 8 > capacity)
+		return -ENOSPC;
+	*bytes_used = bits / 8;
+	return 0;
+}
+#endif
