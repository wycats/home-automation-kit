diff --git a/drivers/media/platform/verisilicon/hantro_drv.c b/drivers/media/platform/verisilicon/hantro_drv.c
index 2e81877..bf2ebed 100644
--- a/drivers/media/platform/verisilicon/hantro_drv.c
+++ b/drivers/media/platform/verisilicon/hantro_drv.c
@@ -97,6 +97,138 @@ static void hantro_job_finish(struct hantro_dev *vpu,
 	hantro_job_finish_no_pm(vpu, ctx, result);
 }
 
+/* One allocation per H.264 job: deferred callbacks never consult curr_ctx.
+ * irqlock protects publication, ownership, abort and the MMIO-live boundary.
+ * Only completion_work retires an armed job. Hardware quiescence remains a
+ * separate validation gate: software ownership cannot tag a late device IRQ.
+ */
+enum hantro_h264_job_owner {
+	HANTRO_H264_PREPARING,
+	HANTRO_H264_RUNNING,
+	HANTRO_H264_IRQ,
+	HANTRO_H264_TIMEOUT,
+	HANTRO_H264_ABORT,
+};
+
+struct hantro_h264_job {
+	struct hantro_ctx *ctx;
+	struct vb2_v4l2_buffer *src;
+	struct vb2_v4l2_buffer *dst;
+	struct delayed_work watchdog;
+	struct work_struct completion_work;
+	enum hantro_h264_job_owner owner;
+	enum vb2_buffer_state result;
+};
+
+static void hantro_h264_claim_locked(struct hantro_h264_job *job,
+				    enum hantro_h264_job_owner owner,
+				    enum vb2_buffer_state result)
+{
+	lockdep_assert_held(&job->ctx->dev->irqlock);
+	if (job->owner != HANTRO_H264_RUNNING)
+		return;
+	job->owner = owner;
+	job->result = result;
+	/* Publish the work while locked: no producer keeps job after unlock. */
+	schedule_work(&job->completion_work);
+}
+
+static void hantro_h264_complete(struct work_struct *work)
+{
+	struct hantro_h264_job *job =
+		container_of(work, struct hantro_h264_job, completion_work);
+	struct hantro_ctx *ctx = job->ctx;
+	struct hantro_dev *vpu = ctx->dev;
+	enum vb2_buffer_state result = job->result;
+	unsigned long flags;
+
+	/* This is neither the watchdog nor an IRQ thread. Drain the loser here. */
+	cancel_delayed_work_sync(&job->watchdog);
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	if (ctx->h264_abort)
+		result = VB2_BUF_STATE_ERROR;
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+
+	if (result == VB2_BUF_STATE_DONE && rk3399_vpu_h264_enc_check_result(ctx))
+		result = VB2_BUF_STATE_ERROR;
+	if (result == VB2_BUF_STATE_DONE && ctx->codec_ops->done)
+		ctx->codec_ops->done(ctx);
+	v4l2_ctrl_request_complete(job->src->vb2_buf.req_obj.req, &ctx->ctrl_handler);
+
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	if (ctx->h264_abort)
+		result = VB2_BUF_STATE_ERROR;
+	/* The existing VEPU2 reset writes IRQ-disable, ENCODE_START=0 and AXI=0.
+	 * Serialize those writes against IRQ MMIO, then prevent further accesses
+	 * before releasing clocks. This is NOT a demonstrated DMA-idle fence.
+	 */
+	if (ctx->codec_ops->reset)
+		ctx->codec_ops->reset(ctx);
+	vpu->h264_mmio_live = false;
+	vpu->h264_job = NULL;
+	ctx->h264_job = NULL;
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+
+	clk_bulk_disable(vpu->variant->num_clocks, vpu->clocks);
+	pm_runtime_put_autosuspend(vpu->dev);
+	/* Framework completion may release ctx and schedule a new same-ctx job.
+	 * No ctx/vpu/buffer access is allowed after this call.
+	 */
+	hantro_job_finish_no_pm(vpu, ctx, result);
+	kfree(job);
+}
+
+static void hantro_h264_timeout(struct work_struct *work)
+{
+	struct hantro_h264_job *job =
+		container_of(to_delayed_work(work), struct hantro_h264_job, watchdog);
+	struct hantro_dev *vpu = job->ctx->dev;
+	unsigned long flags;
+
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	hantro_h264_claim_locked(job, HANTRO_H264_TIMEOUT, VB2_BUF_STATE_ERROR);
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+}
+
+void hantro_h264_enc_irq_locked(struct hantro_dev *vpu,
+				 enum vb2_buffer_state result)
+{
+	lockdep_assert_held(&vpu->irqlock);
+	if (vpu->h264_job)
+		hantro_h264_claim_locked(vpu->h264_job, HANTRO_H264_IRQ, result);
+}
+
+int hantro_h264_enc_arm_locked(struct hantro_ctx *ctx)
+{
+	struct hantro_h264_job *job = ctx->h264_job;
+
+	lockdep_assert_held(&ctx->dev->irqlock);
+	if (ctx->h264_abort)
+		return -ECANCELED;
+	job->owner = HANTRO_H264_RUNNING;
+	/* A freshly initialized, never previously queued per-job timer. */
+	schedule_delayed_work(&job->watchdog, msecs_to_jiffies(2000));
+	return 0;
+}
+
+static void hantro_h264_abort(void *priv)
+{
+	struct hantro_ctx *ctx = priv;
+	struct hantro_dev *vpu = ctx->dev;
+	unsigned long flags;
+
+	if (!ctx->is_encoder || ctx->vpu_dst_fmt->codec_mode != HANTRO_MODE_H264_ENC)
+		return;
+	spin_lock_irqsave(&vpu->irqlock, flags);
+	/* Can precede device_run. STREAMON, not device_run, clears this latch. */
+	ctx->h264_abort = true;
+	if (ctx->h264_job)
+		hantro_h264_claim_locked(ctx->h264_job, HANTRO_H264_ABORT,
+					 VB2_BUF_STATE_ERROR);
+	spin_unlock_irqrestore(&vpu->irqlock, flags);
+	/* mem2mem waits; never wait for work or IRQs while holding irqlock. */
+}
+
 void hantro_irq_done(struct hantro_dev *vpu,
 		     enum vb2_buffer_state result)
 {
@@ -131,6 +263,13 @@ void hantro_watchdog(struct work_struct *work)
 	}
 }
 
+void hantro_watchdog_kick(struct hantro_ctx *ctx)
+{
+	/* Kick the watchdog. */
+	schedule_delayed_work(&ctx->dev->watchdog_work,
+			      msecs_to_jiffies(2000));
+}
