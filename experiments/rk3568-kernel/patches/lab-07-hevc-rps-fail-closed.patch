+int rkvdec_hevc_assemble_hw_rps(struct rkvdec_hevc_run *run, struct rkvdec_rps *rps)
+{
+	const struct v4l2_ctrl_hevc_sps *sps = run->sps;
+	int ret;
+
+	if (sps->num_short_term_ref_pic_sets > RKVDEC_HEVC_MAX_ST_RPS ||
+	    sps->num_long_term_ref_pics_sps > RKVDEC_HEVC_MAX_LT_RPS ||
+	    (sps->num_short_term_ref_pic_sets && !run->ext_sps_st_rps) ||
+	    (sps->num_long_term_ref_pics_sps && !run->ext_sps_lt_rps))
+		return -EINVAL;
+
+	ret = rkvdec_hevc_prepare_hw_st_rps(run, rps);
+	if (ret)
+		return ret;
 	rkvdec_hevc_assemble_hw_lt_rps(run, rps);
+	return 0;
 }
 
